{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "chrome",
            "request": "launch",
            "name": "Open index.html in Chrome",
            "file": "${workspaceFolder}/index.html"
        },
        {
            "type": "msedge",
            "request": "launch",
            "name": "Open index.html in Edge",
            "file": "${workspaceFolder}/index.html"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Launch against Python Server (http://localhost:8000)",
            "url": "http://localhost:8000",
            "webRoot": "${workspaceFolder}"
        }
    ]
}